# Copy this file to profiles.yml and fill in the password.
# profiles.yml is gitignored and must never be committed.

seasia_air_quality:
  target: dev
  outputs:
    dev:
      type: postgres
      host: localhost
      port: 5432
      user: aq_user
      password: your_password_here
      dbname: air_quality
      schema: dbt
      threads: 4
