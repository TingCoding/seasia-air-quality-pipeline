# Copy this file to .env and adjust the values.
# Never commit .env — it is already gitignored.

POSTGRES_USER=aq_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=air_quality
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Change this if the port is already taken on your machine.
ADMINER_PORT=8081

# Open-Meteo requires no API key.
# OpenAQ needs a free key from https://explore.openaq.org/register
OPENAQ_API_KEY=
